{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teachermary",
  "keep_vars": true,
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/l/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "teachermary", "database_id": "51c4060c-8597-45e6-9fe2-38f21a183986", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "teachermary-files" }
  ]
}
